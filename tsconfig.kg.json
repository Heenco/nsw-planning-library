{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noEmit": true, "skipLibCheck": true,
    "esModuleInterop": true, "allowSyntheticDefaultImports": true,
    "types": ["node"], "resolveJsonModule": true
  },
  "include": [
    "server/utils/nsw-kg/**/*.ts",
    "server/utils/embeddings.ts",
    "server/utils/sitewise/**/*.ts",
    "server/utils/kgPool.ts",
    "scripts/seed-source-registry.ts",
    "scripts/ingest-nsw.ts",
    "scripts/build-nsw-edges.ts",
    "scripts/embed-nsw-props.ts"
  ]
}
