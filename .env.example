# ── Required ────────────────────────────────────────────────────────────
# Postgres holding the nsw schema (documents, sections, rules, and the
# up_property_d_3 property table). Every property route and the whole rule
# layer read this. Without it getKgPool() falls back to an SSH tunnel with
# hardcoded defaults that only work on one developer machine.
DATABASE_URL=

# Model provider for answer synthesis and the LEP/SEPP decomposer.
DEEPINFRA_API_KEY=

# Vector tile server for the lot cadastre on the map and property report.
# The report's boundary labels are derived from this layer.
NUXT_PUBLIC_MARTIN_URL=http://172.105.184.178:3000

# Mapbox GL token. Without it the maps render nothing and the landing page
# shows a warning rather than failing silently.
NUXT_PUBLIC_MAPBOX_TOKEN=

# ── Optional ────────────────────────────────────────────────────────────
# Page-view counter on the landing page. Absent = counter hidden.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Alternative model providers, read where configured.
GOOGLE_GEMINI_API_KEY=
GROQ_API_KEY=

# ── Local tooling only — never set these in a deployment ─────────────────
# Read by the maintenance scripts in scripts/, not by the app:
#   ADMIN_DATABASE_URL   preferred by the read-only kg-*/planningai-* checks
#   KG_SSH_*, KG_PG_*    SSH-tunnel fallback for reaching the legacy kg database
ADMIN_DATABASE_URL=
