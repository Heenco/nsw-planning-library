  {
   "id": "burwood-local-environmental-plan-2012:2.6(2)",
   "instrument": "Burwood Local Environmental Plan 2012",
   "clause": "2.6(2)",
   "section": "sec.2.6-ssec.2",
   "when": {
    "all": [
     {
      "fact": "proposal.kind",
      "value": "subdivision",
      "span": "for the subdivision of land"
     },
     {
      "fact": "site.has",
      "value": "secondary dwelling",
      "span": "land on which a secondary dwelling is situated"
     },
     {
      "fact": "proposal.separates",
      "value": "principal dwelling|secondary dwelling",
      "span": "result in the principal dwelling and the secondary dwelling being situated on separate lots"
     },
     {
      "not": {
       "fact": "unparsed",
       "text": "every resulting lot meets the Lot Size Map minimum",
       "span": "unless the resulting lots are not less than the minimum size shown on the Lot Size Map in relation to that land"
      }
     }
    ]
   },
   "then": {
    "prohibit": true
   },
   "author": {
    "by": "claude-opus-5-5 (in session)",
    "at": "2026-10-07"
   }
  },
  {
   "id": "burwood-local-environmental-plan-2012:4.1(3)",
   "instrument": "Burwood Local Environmental Plan 2012",
   "clause": "4.1(3)",
   "section": "sec.4.1-ssec.3",
   "when": {
    "all": [
     {
      "fact": "proposal.kind",
      "value": "subdivision",
      "span": "a subdivision of any land shown on the Lot Size Map"
     },
     {
      "fact": "lot.on_map",
      "value": "lot_size_map",
      "span": "shown on the Lot Size Map"
     },
     {
      "not": {
       "fact": "proposal.subdivision_type",
       "value": "strata",
       "span": "by the registration of a strata plan or strata plan of subdivision under the Strata Schemes Development Act 2015"
      }
     },
     {
      "not": {
       "fact": "proposal.subdivision_type",
       "value": "community",
       "span": "by any kind of subdivision under the Community Land Development Act 2021"
      }
     }
    ]
   },
   "then": {
    "require": {
     "topic": "resulting_lot_size",
     "cmp": "gte",
     "from": "lot_size_map",
     "unit": "m²",
     "kind": "development_standard"
    }
   },
   "author": {
    "by": "claude-opus-5-5 (in session)",
    "at": "2026-10-07"
   }
  }
 ]
